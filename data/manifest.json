  "pages": [
    {
      "id": "prehlad",
      "label": "Prehľad",
      "description": "Základné čísla systému a dva hlavné trendy. Pod každým grafom je tabuľka s presnými hodnotami a export do CSV.",
      "views": [
        "kpi_prehlad",
        "vydavky_celkom_trend",
        "pocty_celkom_trend"
      ]
    },
    {
      "id": "vydavky",
      "label": "Výdavky",
      "description": "Skladba výdavkov na dôchodky a rozklad ich zmeny. Pozostalostné dôchodky (vdovský, vdovecký, sirotský) sú zlúčené do jednej kategórie — je to štandardné delenie a zároveň to drží počet farieb v overenom rozsahu.",
      "views": [
        "vydavky_skladba_mesacne",
        "vydavky_skladba_rocne",
        "vydavky_zmena_wf"
      ]
    },
    {
      "id": "pocty",
      "label": "Počty",
      "description": "Koľko dôchodkov sa vypláca a koľko ľudí ich poberá.",
      "views": [
        "pocty_druhy_trend",
        "dochodky_vs_dochodcovia_trend"
      ]
    },
    {
      "id": "priemerne",
      "label": "Priemerné dôchodky",
      "description": "Priemerný dôchodok podľa druhu a dve rôzne definície priemeru. Sólo priemer zahŕňa len samostatne vyplácané dôchodky, mesačná rada aj krátené — čísla z týchto dvoch zdrojov sa nedajú miešať.",
      "views": [
        "priemer_druhy_trend",
        "priemer_definicie_tab"
      ]
    },
    {
      "id": "novopriznane",
      "label": "Novopriznané",
      "description": "Novopriznané dôchodky a ich výška proti už vyplácaným. Filter platí pre celú stránku a je povinný: obe karty zobrazujú jeden druh dôchodku naraz.",
      "filters": [
        {
          "dataset": "priemer_novo_vs_stav",
          "column": "druh",
          "label": "Druh dôchodku",
          "default": "Starobný",
          "required": true
        }
      ],
      "views": [
        "priemer_novo_vs_stav_trend",
        "novopriznane_trend"
      ]
    },
    {
      "id": "sezonnost",
      "label": "Sezónnosť",
      "description": "Mesačné výdavky ako mriežka rok × mesiac. Vidno na nich počet výplatných termínov v mesiaci aj vyplatenie 13. dôchodku.",
      "views": [
        "sezonnost_heatmap",
        "sezonnost_3d"
      ]
    },
    {
      "id": "demografia",
      "label": "Demografia",
      "description": "Veková štruktúra populácie, ktorá stojí za dlhodobým vývojom systému.",
      "views": [
        "pyramida_2024"
      ]
    },
    {
      "id": "katalog",
      "label": "Dátový katalóg",
      "description": "Zdrojové tabuľky tak, ako ich web číta. Každá sa dá stiahnuť ako CSV. Pôvodné zošity Sociálnej poisťovne sú v data/zdroj/.",
      "views": [
        "tab_vydavky_rocne",
        "tab_pocty",
        "tab_priemer_solo",
        "tab_dochodcovia"
      ]
    }
  ],
  "views": {
    "kpi_prehlad": {
      "type": "tiles",
      "title": "Systém v číslach",
      "subtitle": "Posledné dostupné hodnoty. Zmena je proti predchádzajúcemu mesiacu, u ročných hodnôt proti predchádzajúcemu roku.",
      "dataset": "vydavky_rocne",
      "span": "full",
      "tiles": [
        {
          "label": "Výdavky na dôchodky 2024 (mld. €)",
          "dataset": "vydavky_rocne",
          "value": "mld_eur",
          "unit": "mld. EUR",
          "decimals": 2,
          "hero": true,
          "higherIsBetter": false,
          "deltaUnit": "mld. €",
          "deltaNote": "r/r",
          "transform": [
            {
              "kind": "aggregate",
              "by": [
                "rok"
              ],
              "value": "vydavky_tis_eur",
              "as": "sum"
            },
            {
              "kind": "derive",
              "into": "mld_eur",
              "expr": "v / 1000000",
              "vars": {
                "v": "vydavky_tis_eur"
              }
            },
            {
              "kind": "sort",
              "by": "rok"
            }
          ],
          "note": "Ročná štatistika, vrátane 13. dôchodku."
        },
        {
          "label": "Vyplácané starobné dôchodky",
          "dataset": "pocty_mesacne",
          "value": "pocet",
          "unit": "dôchodkov",
          "transform": [
            {
              "kind": "filter",
              "where": {
                "druh": "Starobný"
              }
            },
            {
              "kind": "sort",
              "by": "mesiac"
            }
          ],
          "deltaNote": "m/m",
          "decimals": 0,
          "note": "Stav 4/2026."
        },
        {
          "label": "Priemerný starobný dôchodok",
          "dataset": "priemer_mesacne",
          "value": "priemer_eur",
          "unit": "EUR",
          "decimals": 2,
          "note": "Aritm. priemer sólo a kráteného dôchodku, 4/2026.",
          "transform": [
            {
              "kind": "filter",
              "where": {
                "druh": "Starobný"
              }
            },
            {
              "kind": "sort",
              "by": "mesiac"
            }
          ],
          "deltaUnit": "€",
          "deltaNote": "m/m"
        },
        {
          "label": "Počet dôchodcov",
          "dataset": "dochodcovia",
          "value": "pocet",
          "unit": "osôb",
          "note": "Osoby, nie dôchodky (12/2024).",
          "transform": [
            {
              "kind": "filter",
              "where": {
                "kategoria": "Spolu"
              }
            },
            {
              "kind": "sort",
              "by": "mesiac"
            }
          ],
          "deltaNote": "m/m",
          "decimals": 0
        }
      ]
    },
