  "pages": [
    {
      "id": "prehlad",
      "label": "Prehľad",
      "description": "Základné čísla systému a dva hlavné trendy. Každá karta má pod grafom tabuľku s presnými hodnotami a export do CSV.",
      "views": [
        "kpi_prehlad",
        "vydavky_celkom",
        "pomer_platitelov"
      ]
    },
    {
      "id": "vydavky",
      "label": "Výdavky",
      "description": "Skladba výdavkov na dôchodky a rozklad ich dlhodobej zmeny na faktory.",
      "filters": [
        {
          "dataset": "vydavky",
          "column": "druh",
          "label": "Druh dôchodku",
          "allLabel": "Všetky druhy"
        }
      ],
      "views": [
        "vydavky_skladba",
        "vydavky_druhy_2070",
        "dekompozicia_wf"
      ]
    },
    {
      "id": "demografia",
      "label": "Demografia",
      "description": "Veková štruktúra a vývoj vzťahu medzi tými, kto do systému platia, a tými, kto z neho poberajú.",
      "views": [
        "pyramida_2024",
        "platitelia_trend",
        "vek_trend"
      ]
    },
    {
      "id": "adekvatnost",
      "label": "Adekvátnosť",
      "description": "Ako sa vyvíja priemerný dôchodok voči priemernej mzde. Obe veličiny sú v eurách, takže patria na jednu os; náhradový pomer je vlastný graf.",
      "views": [
        "mzda_dochodok",
        "nahradovy_trend",
        "mzda_dochodok_index"
      ]
    },
    {
      "id": "citlivost",
      "label": "Citlivosť",
      "description": "Saldo systému ako odozva na dva parametre naraz. 3D povrch ukazuje tvar odozvy, teplotná mapa pod ním tie isté čísla čitateľne — a tabuľka presne.",
      "views": [
        "saldo_3d",
        "saldo_heatmap"
      ]
    },
    {
      "id": "porovnanie",
      "label": "Porovnanie",
      "description": "Výdavky na dôchodky voči starobnej závislosti v krajinách EU.",
      "views": [
        "krajiny_scatter",
        "krajiny_bar"
      ]
    },
    {
      "id": "katalog",
      "label": "Dátový katalóg",
      "description": "Zdrojové tabuľky tak, ako ich web čítá. Každá sa dá stiahnuť ako CSV.",
      "views": [
        "tab_vydavky",
        "tab_platitelia",
        "tab_vek",
        "tab_pilier2"
      ]
    }
  ],
  "views": {
    "kpi_prehlad": {
      "type": "tiles",
      "title": "Systém v číslach",
      "subtitle": "Posledný rok dátovej rady; zmena je proti predchádzajúcemu roku.",
      "dataset": "vydavky",
      "span": "full",
      "tiles": [
        {
          "label": "Výdavky na dôchodky, posledný rok rady",
          "value": "podiel_hdp",
          "unit": "% HDP",
          "hero": true,
          "higherIsBetter": false,
          "deltaUnit": "p. b.",
          "decimals": 2,
          "deltaNote": "r/r",
          "transform": [
            {
              "kind": "aggregate",
              "by": [
                "rok"
              ],
              "value": "podiel_hdp",
              "as": "sum"
            },
            {
              "kind": "sort",
              "by": "rok"
            }
          ]
        },
        {
          "label": "Starobné dôchodky",
          "value": "podiel_hdp",
          "unit": "% HDP",
          "transform": [
            {
              "kind": "filter",
              "where": {
                "druh": "Starobné"
              }
            },
            {
              "kind": "sort",
              "by": "rok"
            }
          ],
          "higherIsBetter": false,
          "deltaUnit": "p. b.",
          "decimals": 2,
          "deltaNote": "r/r"
        },
        {
          "label": "Invalidné dôchodky",
          "value": "podiel_hdp",
          "unit": "% HDP",
          "transform": [
            {
              "kind": "filter",
              "where": {
                "druh": "Invalidné"
              }
            },
            {
              "kind": "sort",
              "by": "rok"
            }
          ],
          "higherIsBetter": false,
          "deltaUnit": "p. b.",
          "decimals": 2
        },
        {
          "label": "Pozostalostné dôchodky",
          "value": "podiel_hdp",
          "unit": "% HDP",
          "transform": [
            {
              "kind": "filter",
              "where": {
                "druh": "Pozostalostné"
              }
            },
            {
              "kind": "sort",
              "by": "rok"
            }
          ],
          "higherIsBetter": false,
          "deltaUnit": "p. b.",
          "decimals": 2
        }
      ]
    },
